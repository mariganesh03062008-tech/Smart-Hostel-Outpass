<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GCE Erode - Smart Hostel Outpass Management System</title>
  <meta name="description" content="Government College of Engineering Erode - Smart Hostel Outpass & Gate Management Platform with Biometric Intelligence">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="css/fantasy.css">
  <link rel="stylesheet" href="css/welcome.css">
  <script>
    (function () {
      try {
        var p = window.location.pathname.toLowerCase();
        var s = window.location.search.toLowerCase();
        var h = window.location.hash.toLowerCase();
        var isDirect = p.includes('/login') || s.includes('role=') || s.includes('mode=') || s.includes('view=login') || h === '#login';
        if (!isDirect) {
          document.documentElement.classList.add('show-welcome');
        }
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <!-- ==========================================================
       INTERACTIVE WELCOME SCREEN (Visual Design: Reference Image)
       ========================================================== -->
  <div id="welcomeScreen" class="welcome-screen" role="region" aria-label="Welcome Screen">
    <!-- Parallax Campus Viewport -->
    <div class="welcome-bg-viewport">
      <div id="welcomeCampusImage" class="welcome-campus-image"></div>
      <div class="welcome-atmosphere-overlay"></div>
    </div>

    <!-- Interactive Cursor Follower Soft Light -->
    <div id="welcomeCursorGlow" class="welcome-cursor-glow" aria-hidden="true"></div>

    <!-- Decorative Luminous Curved Lasers & Foliage Vignette -->
    <div class="welcome-decor-overlay" aria-hidden="true">
      <!-- Top-Right Glowing Cyan Laser Arc -->
      <svg class="welcome-laser-top" viewBox="0 0 680 420" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M680,40 C460,30 260,140 120,380" stroke="url(#laserGradTop)" stroke-width="3" stroke-linecap="round"/>
        <path d="M670,48 C470,42 280,150 140,370" stroke="#38bdf8" stroke-width="1" stroke-opacity="0.6"/>
        <defs>
          <linearGradient id="laserGradTop" x1="100%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.95"/>
            <stop offset="60%" stop-color="#2dd4bf" stop-opacity="0.85"/>
            <stop offset="100%" stop-color="#34d399" stop-opacity="0"/>
          </linearGradient>
        </defs>
      </svg>

      <!-- Bottom-Left Glowing Cyan/Green Laser Arc -->
      <svg class="welcome-laser-bottom" viewBox="0 0 620 380" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,320 C180,310 360,250 580,40" stroke="url(#laserGradBottom)" stroke-width="3" stroke-linecap="round"/>
        <path d="M10,326 C190,316 370,256 570,55" stroke="#2dd4bf" stroke-width="1" stroke-opacity="0.6"/>
        <defs>
          <linearGradient id="laserGradBottom" x1="0%" y1="100%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#34d399" stop-opacity="0.95"/>
            <stop offset="55%" stop-color="#2dd4bf" stop-opacity="0.85"/>
            <stop offset="100%" stop-color="#38bdf8" stop-opacity="0"/>
          </linearGradient>
        </defs>
      </svg>

      <!-- Foliage Framing -->
      <div class="welcome-foliage-frame"></div>
    </div>

    <!-- Floating Dust & Light Particle Canvas -->
    <canvas id="welcomeParticlesCanvas" class="welcome-particles-canvas" aria-hidden="true"></canvas>

    <!-- Center Content (Micro Parallax Depth) -->
    <main id="welcomeCenterContent" class="welcome-center-content">
      <!-- Graduation Cap Icon with Fine Horizontal Accent Lines -->
      <div class="welcome-cap-block">
        <div class="welcome-cap-wing left"></div>
        <div class="welcome-cap-icon-wrapper" aria-hidden="true">
          <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Sleek Mortarboard Cap Outline -->
            <path d="M32 10L6 23L32 36L58 23L32 10Z" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M14 27.5V42C14 42 21 49 32 49C43 49 50 42 50 42V27.5" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M58 24V40" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
            <circle cx="58" cy="42" r="2.5" fill="currentColor"/>
          </svg>
        </div>
        <div class="welcome-cap-wing right"></div>
      </div>

      <!-- Main College Title -->
      <h1 class="welcome-title">GCE Erode</h1>

      <!-- Project Subtitle -->
      <p class="welcome-subtitle">SMART HOSTEL OUTPASS SYSTEM</p>

      <!-- Delicate Green Sprout Divider -->
      <div class="welcome-sprout-divider" aria-hidden="true">
        <div class="welcome-sprout-line left"></div>
        <div class="welcome-sprout-icon">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 21V11C12 7.5 9.5 4.5 5 4C5 8.5 7.5 11.5 12 11" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M12 14C14.5 11.5 18 11.5 19 12C19.5 15.5 16.5 18.5 12 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="welcome-sprout-line right"></div>
      </div>

      <!-- ENTER Pill Button -->
      <button id="welcomeEnterBtn" class="welcome-enter-btn" type="button" aria-label="Enter Smart Hostel Outpass System">
        <span class="welcome-enter-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
            <polyline points="10 17 15 12 10 7"></polyline>
            <line x1="15" y1="12" x2="3" y2="12"></line>
          </svg>
        </span>
        <span class="welcome-enter-text">ENTER</span>
        <span class="welcome-enter-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </button>
    </main>
  </div>

  <!-- Animated GCE Erode Campus Background (Ken Burns Animation) -->
  <div class="campus-bg-container" aria-hidden="true">
    <div class="campus-bg-image"></div>
    <div class="campus-bg-overlay"></div>
  </div>

  <!-- Interactive Fantasy Particle Nebula Canvas -->
  <canvas id="fantasyCanvas" class="fantasy-canvas"></canvas>

  <div class="app-wrapper">
    <!-- Top Navigation Bar -->
    <header class="navbar">
      <div class="navbar-brand">
        <div class="brand-logo-badge">
          <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
          </svg>
        </div>
        <div class="brand-text">
          <span class="brand-title">GCE Erode</span>
          <span class="brand-subtitle">Smart Hostel Outpass System</span>
        </div>
      </div>

      <div class="navbar-actions">
        <!-- Minimalist System Status -->
        <div class="system-status-chip" id="systemStatusChip" title="Server & Database status">
          <span class="status-dot online pulsing" id="statusDot"></span>
          <span class="status-label" id="statusLabel">Server Online</span>
          <span class="db-badge connected" id="dbBadge">DB Connected</span>
        </div>

        <!-- Theme Toggle Button -->
        <button class="icon-button" id="themeToggleBtn" aria-label="Toggle Dark/Light Mode" title="Toggle Dark/Light Mode">
          <svg id="themeIconDark" class="theme-icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg id="themeIconLight" class="theme-icon hidden" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </header>

    <!-- Main Content Area (Clean Centered Layout - Removed Extra Hero Clutter) -->
    <main class="main-container">
      <div class="auth-centered-wrapper">
        
        <!-- Portal Auth Card (Dual-Mode: Sign In & Register) -->
        <section class="auth-card">
          <div class="auth-card-header">
            <div class="portal-badge" id="roleBadge">Student Portal</div>
            <h2 class="auth-title" id="authTitle">Sign In to Outpass System</h2>
            <p class="auth-subtitle" id="authSubtitle">Select your role to access your dedicated dashboard.</p>
          </div>

          <!-- PRIMARY DUAL-MODE SWITCHER: [ 🔑 Sign In | ✨ Register ] -->
          <div class="auth-mode-switch-wrapper">
            <div class="auth-mode-switch" id="authModeSwitch">
              <button type="button" class="auth-mode-btn active" id="modeBtnLogin" onclick="setAuthMode('login')">
                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none">
                  <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                  <polyline points="10 17 15 12 10 7"></polyline>
                  <line x1="15" y1="12" x2="3" y2="12"></line>
                </svg>
                <span>Sign In</span>
              </button>
              <button type="button" class="auth-mode-btn" id="modeBtnRegister" onclick="setAuthMode('register')">
                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="8.5" cy="7" r="4"></circle>
                  <line x1="20" y1="8" x2="20" y2="14"></line>
                  <line x1="23" y1="11" x2="17" y2="11"></line>
                </svg>
                <span>Register</span>
              </button>
              <div class="auth-mode-indicator" id="authModeIndicator"></div>
            </div>
          </div>

          <!-- Notification / Error Banner -->
          <div id="formAlert" class="form-alert hidden" role="alert"></div>

          <!-- ====================================================
               1. LOGIN SECTION (VISIBLE WHEN MODE IS 'LOGIN')
               ==================================================== -->
          <div id="loginSection" class="auth-section-content">
            <!-- Role Selector Navigation (7 Roles) -->
            <div class="role-selector-wrapper" style="margin-bottom: 1.2rem;">
              <label class="role-label">Choose Role:</label>
              <div class="role-tabs" id="roleTabs">
                <button type="button" class="role-tab active" data-role="student" title="Student Access">
                  <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
                  <span>Student</span>
                </button>
                <button type="button" class="role-tab" data-role="parent" title="Parent Consent & Tracking">
                  <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                  <span>Parent</span>
                </button>
                <button type="button" class="role-tab" data-role="warden" title="Hostel Warden Portal">
                  <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                  <span>Warden</span>
                </button>
                <button type="button" class="role-tab" data-role="principal" title="Principal Oversight">
                  <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
                  <span>Principal</span>
                </button>
                <button type="button" class="role-tab" data-role="class_advisor" title="Class Advisor Approval">
                  <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                  <span>Class Advisor</span>
                </button>
                <button type="button" class="role-tab" data-role="caretaker" title="Hostel Caretaker">
                  <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                  <span>Caretaker</span>
                </button>
                <button type="button" class="role-tab" data-role="watchman" title="Gate Security Staff">
                  <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                  <span>Watchman</span>
                </button>
              </div>
            </div>

            <!-- Dynamic Login Form -->
            <form class="login-form" id="loginForm" autocomplete="on">
              <input type="hidden" id="selectedRole" name="role" value="student">

              <!-- Identifier Field -->
              <div class="form-group">
                <label for="identifierInput" id="identifierLabel">Register / Roll Number</label>
                <div class="input-wrapper">
                  <span class="input-icon">
                    <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                      <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                  </span>
                  <input 
                    type="text" 
                    id="identifierInput" 
                    placeholder="Enter your roll number (e.g. 21CS042)" 
                    required 
                    autocomplete="username"
                  />
                </div>
              </div>

              <!-- Password Field -->
              <div class="form-group">
                <div class="label-row">
                  <label for="passwordInput">Password</label>
                  <a href="#" class="forgot-link" onclick="showAlert('Please contact your Hostel Warden or Administrator to reset your password.', 'info'); return false;">Forgot Password?</a>
                </div>
                <div class="input-wrapper">
                  <span class="input-icon">
                    <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none">
                      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                  </span>
                  <input 
                    type="password" 
                    id="passwordInput" 
                    placeholder="Enter your password" 
                    required 
                    autocomplete="current-password"
                  />
                  <button type="button" class="toggle-pwd-btn" id="togglePasswordBtn" aria-label="Toggle password visibility">
                    <svg class="eye-icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Remember Me -->
              <div class="form-options">
                <label class="custom-checkbox">
                  <input type="checkbox" id="rememberMe">
                  <span class="checkmark"></span>
                  <span class="checkbox-text">Remember Credentials</span>
                </label>
              </div>

              <!-- Submit Button -->
              <button type="submit" class="primary-btn" id="submitBtn">
                <span class="btn-text" id="btnText">Sign In to Dashboard</span>
                <span class="btn-spinner hidden" id="btnSpinner"></span>
                <svg class="btn-arrow" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>

              <!-- Switch Boxes for Direct Inline Switching -->
              <div class="student-auth-switch-section hidden" id="studentCreateAccountBox" style="text-align: center; margin-top: 1rem;">
                <p class="auth-switch-text" style="font-size: 0.88rem; color: var(--text-secondary);">New student? <button type="button" class="link-btn inline-auth-toggle-btn" onclick="showStudentRegisterForm()" style="background: none; border: none; color: #a855f7; cursor: pointer; font-weight: 600; text-decoration: underline;">Create Account</button></p>
              </div>
              <div class="parent-auth-switch-section" id="parentCreateAccountBox" style="text-align: center; margin-top: 1rem;">
                <p class="auth-switch-text" style="font-size: 0.88rem; color: var(--text-secondary);">New parent? <button type="button" class="link-btn inline-auth-toggle-btn" onclick="showParentRegisterForm()" style="background: none; border: none; color: #a855f7; cursor: pointer; font-weight: 600; text-decoration: underline;">Create Parent Account</button></p>
              </div>
            </form>

            <!-- Sleek Collapsible Demo Accounts Box -->
            <div class="demo-expander-box" id="demoExpanderBox">
              <button type="button" class="demo-expander-toggle" id="demoExpanderBtn" onclick="toggleDemoAccounts()">
                <span style="display:flex; align-items:center; gap:0.4rem;">
                  <span>⚡ Quick Demo Credentials</span>
                  <span style="font-size:0.75rem; opacity:0.7;">(Password@123)</span>
                </span>
                <svg class="toggle-icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="demo-chips-drawer" id="demoChipsDrawer">
                <div class="demo-chips" style="display:flex; flex-wrap:wrap; gap:0.4rem; padding:0.25rem 0;">
                  <button type="button" class="demo-chip" data-fill-role="student" data-fill-id="21CS042">🎓 Student</button>
                  <button type="button" class="demo-chip" data-fill-role="parent" data-fill-id="9876543210">👨‍👩‍👧 Parent</button>
                  <button type="button" class="demo-chip" data-fill-role="warden" data-fill-id="WRD-101">🛡️ Warden</button>
                  <button type="button" class="demo-chip" data-fill-role="principal" data-fill-id="PRC-001">🏛️ Principal</button>
                  <button type="button" class="demo-chip" data-fill-role="class_advisor" data-fill-id="ADV-204">📚 Advisor</button>
                  <button type="button" class="demo-chip" data-fill-role="caretaker" data-fill-id="CTK-305">🏠 Caretaker</button>
                  <button type="button" class="demo-chip" data-fill-role="watchman" data-fill-id="SEC-001">👮 Watchman</button>
                </div>
              </div>
            </div>
          </div>

          <!-- ===========          <!-- ====================================================
               2. REGISTER SECTION (PARENT & STUDENT REGISTRATION)
               ==================================================== -->
          <div id="registerSection" class="auth-section-content hidden">
            <!-- Registration Role Sub-Tabs (Switch between Parent and Student) -->
            <div class="register-sub-tabs" role="tablist">
              <button type="button" class="register-sub-tab active" id="regRoleParentBtn" onclick="setRegisterRole('parent')" role="tab" aria-selected="true">
                <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                <span>Parent Registration</span>
              </button>
              <button type="button" class="register-sub-tab" id="regRoleStudentBtn" onclick="setRegisterRole('student')" role="tab" aria-selected="false">
                <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
                <span>Student Registration</span>
              </button>
            </div>

            <!-- Informational Banner for Parent Registration -->
            <div class="reg-staff-note" id="parentRegNotice" style="margin-bottom: 1.25rem;">
              <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
              <div style="flex: 1;">
                <strong>Parent Account:</strong> Links directly to your child's student record.
                <div style="margin-top: 0.25rem; font-size: 0.8rem; opacity: 0.9;">
                  Child not registered yet? <button type="button" onclick="setRegisterRole('student')" style="background: none; border: none; color: #c084fc; cursor: pointer; text-decoration: underline; font-weight: 600; padding: 0;">Register Student first</button>
                </div>
              </div>
            </div>

            <!-- Informational Banner for Student Registration -->
            <div class="reg-staff-note hidden" id="studentRegNotice" style="margin-bottom: 1.25rem;">
              <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
              <div style="flex: 1;">
                <strong>Student Account:</strong> Enter your official College Roll Number (e.g. 21CS042). Your account will be created immediately with outpass access.
              </div>
            </div>

            <!-- 1. INLINE PARENT REGISTRATION FORM (Strict Student Linking) -->
            <form class="login-form" id="parentRegisterForm" autocomplete="on" onsubmit="handleParentInlineRegisterSubmit(event)">
              <!-- Parent Name -->
              <div class="form-group" id="group_parentRegName">
                <label for="parentRegName">Parent / Guardian Full Name</label>
                <div class="input-wrapper" id="wrapper_parentRegName">
                  <span class="input-icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                  </span>
                  <input 
                    type="text" 
                    id="parentRegName" 
                    placeholder="Enter your full name" 
                    required 
                  />
                </div>
