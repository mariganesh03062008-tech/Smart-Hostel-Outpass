        window.location.replace('/parent-dashboard.html');
      }, 400);
    } else {
      showAlert(data.message || 'Registration failed.', 'error');
    }
  } catch (err) {
    showAlert('Network error during registration: ' + err.message, 'error');
  } finally {
    if (btn) btn.disabled = false;
  }
